rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // All user-owned media files.
    // Path: users/{userId}/... (any depth)
    //
    // Reads are open to any authenticated user — card IDs are not guessable,
    // and shared/marketplace content must be readable by other users.
    // create/update are restricted to the owning user, capped at 10 MB, and
    // restricted to image/audio content types (#285 R6) — previously
    // unbounded, a storage-cost/abuse vector even though writes were already
    // scoped to the caller's own path. delete has no request.resource (there's
    // no resulting object), so it's checked separately without those two
    // conditions — combining it under a single `write` rule would make every
    // delete fail (request.resource.size on a delete errors, and rules fail
    // closed on error).
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId &&
          request.resource.size < 10 * 1024 * 1024 &&
          request.resource.contentType.matches('image/.*|audio/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

  }
}